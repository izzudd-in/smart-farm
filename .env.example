DATABASE_URL="postgresql://smartfarm:CHANGE_ME@127.0.0.1:5432/smartfarm?schema=public"
AUTH_SECRET="change-me-with-a-long-random-secret-at-least-32-characters"
APP_URL="https://your-farm-domain.com"
NODE_ENV="production"

# One-time production bootstrap only.
# Remove these four values from the VPS .env after bootstrap succeeds.
INITIAL_FARM_NAME="UdinFarm"
INITIAL_OWNER_NAME="Owner"
INITIAL_OWNER_EMAIL="YOUR_OWNER_EMAIL"
INITIAL_OWNER_PASSWORD="CHANGE_ME_MINIMUM_8_CHARACTERS"