generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  OPERATOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kandangs     Kandang[]     @relation("KandangOperators")
  dailyReports DailyReport[] @relation("DailyReportOperator")

  @@index([role])
  @@index([isActive])
}

model Farm {
  id        String   @id @default(cuid())
  scope     String   @unique @default("PRIMARY")
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kandangs        Kandang[]
  feedIngredients FeedIngredient[]
  feedFormulas    FeedFormula[]
  customers       Customer[]
  eggPrices       EggPrice[]
  orders          Order[]
}

model Kandang {
  id            String   @id @default(cuid())
  farmId        String
  code          String
  name          String
  isActive      Boolean  @default(true)
  activeFlockId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  operators    User[]        @relation("KandangOperators")
  flocks       Flock[]       @relation("KandangFlocks")
  activeFlock  Flock?        @relation("ActiveFlock", fields: [activeFlockId], references: [id], onDelete: SetNull)
  dailyReports DailyReport[]

  @@unique([farmId, code])
  @@unique([farmId, name])
  @@index([farmId])
  @@index([isActive])
}

model Flock {
  id                String    @id @default(cuid())
  kandangId         String
  name              String
  startDate         DateTime  @db.Date
  initialPopulation Int
  endedAt           DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  kandang          Kandang       @relation("KandangFlocks", fields: [kandangId], references: [id], onDelete: Cascade)
  activeForKandang Kandang?      @relation("ActiveFlock")
  dailyReports     DailyReport[]

  @@unique([kandangId, name])
  @@index([kandangId, startDate])
}

model DailyReport {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  kandangId  String
  flockId    String
  operatorId String

  saleableEgg Float?
  damagedEgg  Float?
  feedUsed    Float?
  mortality   Int?

  incidentalExpense Decimal? @db.Decimal(14, 2)
  incidentNote      String?  @db.Text

  feedFormulaId           String?
  feedFormulaNameSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kandang  Kandang @relation(fields: [kandangId], references: [id], onDelete: Restrict)
  flock    Flock   @relation(fields: [flockId], references: [id], onDelete: Restrict)
  operator User    @relation("DailyReportOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  feedFormula FeedFormula?         @relation(fields: [feedFormulaId], references: [id], onDelete: SetNull)
  feedItems   DailyReportFeedItem[]

  @@unique([date, kandangId])
  @@index([operatorId, date])
  @@index([flockId, date])
  @@index([kandangId, date])
  @@index([feedFormulaId])
}

model DailyReportFeedItem {
  id                     String  @id @default(cuid())
  dailyReportId          String
  ingredientId           String
  ingredientNameSnapshot String
  percentage             Decimal @db.Decimal(5, 2)

  dailyReport DailyReport    @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  ingredient  FeedIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([dailyReportId, ingredientId])
  @@index([ingredientId])
}

model FeedIngredient {
  id                String   @id @default(cuid())
  farmId            String
  name              String
  unit              String   @default("kg")
  currentPricePerKg Decimal  @db.Decimal(14, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  farm                 Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  formulaItems         FeedFormulaItem[]
  dailyReportFeedItems DailyReportFeedItem[]

  @@unique([farmId, name])
  @@index([farmId, isActive])
}

model FeedFormula {
  id        String   @id @default(cuid())
  farmId    String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm         Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  items        FeedFormulaItem[]
  dailyReports DailyReport[]

  @@unique([farmId, name])
  @@index([farmId, isActive])
}

model FeedFormulaItem {
  id           String  @id @default(cuid())
  formulaId    String
  ingredientId String
  percentage   Decimal @db.Decimal(5, 2)

  formula    FeedFormula    @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  ingredient FeedIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([formulaId, ingredientId])
  @@index([ingredientId])
}

model Customer {
  id            String   @id @default(cuid())
  farmId        String
  name          String
  phone         String?
  address       String?
  discountPerKg Decimal  @default(0) @db.Decimal(14, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([farmId, isActive])
  @@index([farmId, name])
}

model EggPrice {
  id          String   @id @default(cuid())
  farmId      String
  pricePerKg  Decimal  @db.Decimal(14, 2)
  effectiveAt DateTime @db.Date
  createdAt   DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Restrict)

  @@index([farmId, effectiveAt])
}

model Order {
  id                   String   @id @default(cuid())
  farmId               String
  customerId           String
  customerNameSnapshot String
  orderedAt            DateTime @db.Date

  quantityKg      Decimal @db.Decimal(14, 3)
  basePricePerKg  Decimal @db.Decimal(14, 2)
  discountPerKg   Decimal @db.Decimal(14, 2)
  finalPricePerKg Decimal @db.Decimal(14, 2)
  totalPrice      Decimal @db.Decimal(18, 2)

  note      String?  @db.Text
  createdAt DateTime @default(now())

  farm     Farm     @relation(fields: [farmId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([farmId, orderedAt])
  @@index([customerId, orderedAt])
}

model SystemState {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}