generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  OPERATOR
}

enum EggStockAdjustmentType {
  OPENING
  INCREASE
  DECREASE
}

enum FeedStockAdjustmentType {
  OPENING
  INCREASE
  DECREASE
}

enum FeedCostBasis {
  LATEST_PURCHASE
  MASTER_PRICE
}

enum RoutineCostCategory {
  SALARY
  ELECTRICITY
  WATER
  INTERNET
  RENT
  SECURITY
  OTHER
}

enum DailyExpenseCategory {
  MEDICINE_VITAMIN
  DISINFECTANT
  OVERTIME
  MAINTENANCE
  TRANSPORT
  EQUIPMENT
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kandangs             Kandang[]            @relation("KandangOperators")
  dailyReports         DailyReport[]        @relation("DailyReportOperator")
  eggStockAdjustments  EggStockAdjustment[] @relation("EggStockAdjustmentCreator")
  feedPurchases        FeedPurchase[]       @relation("FeedPurchaseCreator")
  feedStockAdjustments FeedStockAdjustment[] @relation("FeedStockAdjustmentCreator")
  routineCosts         RoutineCost[]         @relation("RoutineCostCreator")
  dailyExpenses        DailyExpense[]        @relation("DailyExpenseCreator")

  @@index([role])
  @@index([isActive])
}

model Farm {
  id        String   @id @default(cuid())
  scope     String   @unique @default("PRIMARY")
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kandangs             Kandang[]
  feedIngredients      FeedIngredient[]
  feedFormulas         FeedFormula[]
  customers            Customer[]
  eggPrices            EggPrice[]
  orders               Order[]
  eggStockAdjustments  EggStockAdjustment[]
  feedPurchases        FeedPurchase[]
  feedStockAdjustments FeedStockAdjustment[]
  routineCosts         RoutineCost[]
  dailyExpenses        DailyExpense[]
}

model Kandang {
  id            String   @id @default(cuid())
  farmId        String
  code          String
  name          String
  isActive      Boolean  @default(true)
  activeFlockId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm         Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  operators    User[]        @relation("KandangOperators")
  flocks       Flock[]       @relation("KandangFlocks")
  activeFlock  Flock?        @relation("ActiveFlock", fields: [activeFlockId], references: [id], onDelete: SetNull)
  dailyReports DailyReport[]

  @@unique([farmId, code])
  @@unique([farmId, name])
  @@index([farmId])
  @@index([isActive])
}

model Flock {
  id                String    @id @default(cuid())
  kandangId         String
  name              String
  startDate         DateTime  @db.Date
  initialPopulation Int
  endedAt           DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  kandang          Kandang      @relation("KandangFlocks", fields: [kandangId], references: [id], onDelete: Cascade)
  activeForKandang Kandang?     @relation("ActiveFlock")
  dailyReports     DailyReport[]

  @@unique([kandangId, name])
  @@index([kandangId, startDate])
  @@index([kandangId, endedAt])
}

model DailyReport {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  kandangId  String
  flockId    String
  operatorId String

  saleableEgg Float?
  damagedEgg  Float?
  feedUsed    Float?
  mortality   Int?

  incidentalExpense         Decimal?              @db.Decimal(14, 2)
  incidentalExpenseCategory DailyExpenseCategory?
  incidentNote              String?               @db.Text

  feedFormulaId           String?
  feedFormulaNameSnapshot String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kandang  Kandang @relation(fields: [kandangId], references: [id], onDelete: Restrict)
  flock    Flock   @relation(fields: [flockId], references: [id], onDelete: Restrict)
  operator User    @relation("DailyReportOperator", fields: [operatorId], references: [id], onDelete: Restrict)

  feedFormula FeedFormula?          @relation(fields: [feedFormulaId], references: [id], onDelete: SetNull)
  feedItems   DailyReportFeedItem[]

  @@unique([date, kandangId])
  @@index([operatorId, date])
  @@index([flockId, date])
  @@index([kandangId, date])
  @@index([feedFormulaId])
  @@index([date, incidentalExpenseCategory])
}

model DailyReportFeedItem {
  id                     String         @id @default(cuid())
  dailyReportId          String
  ingredientId           String
  ingredientNameSnapshot String
  percentage             Decimal        @db.Decimal(5, 2)
  unitCostPerKgSnapshot  Decimal?       @db.Decimal(14, 2)
  costBasisSnapshot      FeedCostBasis?

  dailyReport DailyReport    @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  ingredient  FeedIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([dailyReportId, ingredientId])
  @@index([ingredientId])
}

model FeedIngredient {
  id                String   @id @default(cuid())
  farmId            String
  name              String
  unit              String   @default("kg")
  currentPricePerKg Decimal  @db.Decimal(14, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  farm                 Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  formulaItems         FeedFormulaItem[]
  dailyReportFeedItems DailyReportFeedItem[]
  purchases            FeedPurchase[]
  stockAdjustments     FeedStockAdjustment[]

  @@unique([farmId, name])
  @@index([farmId, isActive])
}

model FeedFormula {
  id        String   @id @default(cuid())
  farmId    String
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm         Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  items        FeedFormulaItem[]
  dailyReports DailyReport[]

  @@unique([farmId, name])
  @@index([farmId, isActive])
}

model FeedFormulaItem {
  id           String  @id @default(cuid())
  formulaId    String
  ingredientId String
  percentage   Decimal @db.Decimal(5, 2)

  formula    FeedFormula    @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  ingredient FeedIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([formulaId, ingredientId])
  @@index([ingredientId])
}

model Customer {
  id            String   @id @default(cuid())
  farmId        String
  name          String
  phone         String?
  address       String?
  discountPerKg Decimal  @default(0) @db.Decimal(14, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Restrict)
  orders Order[]

  @@index([farmId, isActive])
  @@index([farmId, name])
}

model EggPrice {
  id          String   @id @default(cuid())
  farmId      String
  pricePerKg  Decimal  @db.Decimal(14, 2)
  effectiveAt DateTime @db.Date
  createdAt   DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Restrict)

  @@index([farmId, effectiveAt])
}

model Order {
  id                   String   @id @default(cuid())
  farmId               String
  customerId           String
  customerNameSnapshot String
  orderedAt            DateTime @db.Date

  quantityKg      Decimal @db.Decimal(14, 3)
  basePricePerKg  Decimal @db.Decimal(14, 2)
  discountPerKg   Decimal @db.Decimal(14, 2)
  finalPricePerKg Decimal @db.Decimal(14, 2)
  totalPrice      Decimal @db.Decimal(18, 2)

  note      String?  @db.Text
  createdAt DateTime @default(now())

  farm     Farm     @relation(fields: [farmId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([farmId, orderedAt])
  @@index([customerId, orderedAt])
}

model EggStockAdjustment {
  id          String                 @id @default(cuid())
  farmId      String
  occurredAt  DateTime               @db.Date
  type        EggStockAdjustmentType
  quantityKg  Decimal                @db.Decimal(14, 3)
  note        String?                @db.Text
  createdById String
  openingKey  String?                @unique
  createdAt   DateTime               @default(now())

  farm      Farm @relation(fields: [farmId], references: [id], onDelete: Restrict)
  createdBy User @relation("EggStockAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([farmId, occurredAt])
  @@index([farmId, type])
  @@index([createdById])
}

model FeedPurchase {
  id           String   @id @default(cuid())
  farmId       String
  ingredientId String
  purchasedAt  DateTime @db.Date

  quantityKg     Decimal @db.Decimal(14, 3)
  unitPricePerKg Decimal @db.Decimal(14, 2)
  totalPrice     Decimal @db.Decimal(18, 2)

  supplier    String?
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  farm       Farm           @relation(fields: [farmId], references: [id], onDelete: Restrict)
  ingredient FeedIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdBy  User           @relation("FeedPurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([farmId, purchasedAt])
  @@index([ingredientId, purchasedAt])
  @@index([createdById])
}

model FeedStockAdjustment {
  id           String                  @id @default(cuid())
  farmId       String
  ingredientId String
  occurredAt   DateTime                @db.Date
  type         FeedStockAdjustmentType
  quantityKg   Decimal                 @db.Decimal(14, 3)
  note         String?                 @db.Text
  createdById  String
  openingKey   String?                 @unique
  createdAt    DateTime                @default(now())

  farm       Farm           @relation(fields: [farmId], references: [id], onDelete: Restrict)
  ingredient FeedIngredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  createdBy  User           @relation("FeedStockAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([farmId, occurredAt])
  @@index([ingredientId, occurredAt])
  @@index([ingredientId, type])
  @@index([createdById])
}

model RoutineCost {
  id          String              @id @default(cuid())
  farmId      String
  category    RoutineCostCategory
  name        String
  amount      Decimal             @db.Decimal(18, 2)
  periodStart DateTime            @db.Date
  periodEnd   DateTime            @db.Date
  note        String?             @db.Text
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  farm      Farm @relation(fields: [farmId], references: [id], onDelete: Restrict)
  createdBy User @relation("RoutineCostCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([farmId, periodStart, periodEnd])
  @@index([farmId, category])
  @@index([createdById])
}

model DailyExpense {
  id          String               @id @default(cuid())
  farmId      String
  category    DailyExpenseCategory
  amount      Decimal              @db.Decimal(18, 2)
  occurredAt  DateTime             @db.Date
  description String               @db.Text
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  farm      Farm @relation(fields: [farmId], references: [id], onDelete: Restrict)
  createdBy User @relation("DailyExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([farmId, occurredAt])
  @@index([farmId, category, occurredAt])
  @@index([createdById])
}

model SystemState {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}